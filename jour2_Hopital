-- Nombre de consultations par médecin
SELECT m.nom, m.specialite, COUNT(c.id_consultation) AS nb_consultations
FROM Medecin m
LEFT JOIN Consultation c ON m.id_medecin = c.id_medecin
GROUP BY m.nom, m.specialite;
 
-- Patients consultés plusieurs fois
SELECT p.nom, COUNT(c.id_consultation) AS nb_visites
FROM Patient p
JOIN Consultation c ON p.id_patient = c.id_patient
GROUP BY p.nom
HAVING COUNT(c.id_consultation) > 1;
 