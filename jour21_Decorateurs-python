import time
import functools

def chronometre(func):
    """Décorateur qui mesure le temps d'exécution."""
    @functools.wraps(func)
    def wrapper(*args, **kwargs):
        debut = time.time()
        resultat = func(*args, **kwargs)
        fin = time.time()
        print(f"[{func.__name__}] Temps : {fin - debut:.4f}s")
        return resultat
    return wrapper

def memorisation(func):
    """Décorateur de mémoïsation (cache des résultats)."""
    cache = {}
    @functools.wraps(func)
    def wrapper(*args):
        if args not in cache:
            cache[args] = func(*args)
        return cache[args]
    return wrapper

@chronometre
@memorisation
def fibonacci(n):
    if n <= 1: return n
    return fibonacci(n - 1) + fibonacci(n - 2)

@chronometre
def somme_carres(n):
    return sum(i**2 for i in range(n))

if __name__ == "__main__":
    print(f"Fibonacci(35) = {fibonacci(35)}")
    print(f"Somme carrés(10000) = {somme_carres(10000)}")