# Jour 12 - Générateur de mots de passe
# Niveau L2 - Python standard library

import random
import string

def generer_mot_de_passe(longueur=12, majuscules=True, chiffres=True, symboles=True):
    """Génère un mot de passe aléatoire sécurisé."""
    caracteres = string.ascii_lowercase
    if majuscules: caracteres += string.ascii_uppercase
    if chiffres:   caracteres += string.digits
    if symboles:   caracteres += "!@#$%^&*()-_=+"

    # Garantir au moins un caractère de chaque catégorie
    mdp = [random.choice(string.ascii_lowercase)]
    if majuscules: mdp.append(random.choice(string.ascii_uppercase))
    if chiffres:   mdp.append(random.choice(string.digits))
    if symboles:   mdp.append(random.choice("!@#$%^&*()-_=+"))

    # Compléter jusqu'à la longueur voulue
    while len(mdp) < longueur:
        mdp.append(random.choice(caracteres))

    random.shuffle(mdp)
    return ''.join(mdp)

def evaluer_force(mdp):
    """Évalue la force d'un mot de passe."""
    score = 0
    if len(mdp) >= 8: score += 1
    if len(mdp) >= 12: score += 1
    if any(c.isupper() for c in mdp): score += 1
    if any(c.isdigit() for c in mdp): score += 1
    if any(c in "!@#$%^&*()-_=+" for c in mdp): score += 1
    niveaux = {5: "Très fort 💪", 4: "Fort ✅", 3: "Moyen ⚠️", 2: "Faible ❌", 1: "Très faible 🚨"}
    return niveaux.get(score, "Très faible 🚨")

if __name__ == "__main__":
    for _ in range(5):
        mdp = generer_mot_de_passe(14)
        print(f"{mdp}  =>  {evaluer_force(mdp)}")