-- Jour 20 - SQL : Réseau social simplifié
-- Niveau L2 - SQL (auto-jointure, requêtes complexes)

CREATE TABLE Utilisateur (
    id_user INTEGER PRIMARY KEY,
    pseudo VARCHAR(50) UNIQUE,
    date_inscription DATE
);

CREATE TABLE Amitie (
    id_user1 INTEGER,
    id_user2 INTEGER,
    date_amitie DATE,
    PRIMARY KEY (id_user1, id_user2),
    FOREIGN KEY (id_user1) REFERENCES Utilisateur(id_user),
    FOREIGN KEY (id_user2) REFERENCES Utilisateur(id_user)
);

CREATE TABLE Publication (
    id_pub INTEGER PRIMARY KEY,
    id_user INTEGER,
    contenu TEXT,
    date_pub DATETIME,
    FOREIGN KEY (id_user) REFERENCES Utilisateur(id_user)
);

CREATE TABLE Reaction (
    id_user INTEGER,
    id_pub INTEGER,
    type_reaction VARCHAR(10), -- 'like', 'love', 'haha'
    PRIMARY KEY (id_user, id_pub)
);

