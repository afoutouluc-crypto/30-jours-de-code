-- Nombre d'amis par utilisateur
SELECT u.pseudo, COUNT(*) AS nb_amis
FROM Utilisateur u
JOIN Amitie a ON u.id_user = a.id_user1 OR u.id_user = a.id_user2
GROUP BY u.pseudo;

-- Publications avec le nombre de réactions
SELECT u.pseudo, p.contenu, COUNT(r.id_user) AS nb_reactions
FROM Publication p
JOIN Utilisateur u ON p.id_user = u.id_user
LEFT JOIN Reaction r ON p.id_pub = r.id_pub
GROUP BY p.id_pub, u.pseudo, p.contenu;