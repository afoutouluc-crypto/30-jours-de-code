-- Requêtes utiles
-- Total dépensé par client
SELECT c.nom, SUM(cmd.total) AS total_depense
FROM Client c
JOIN Commande cmd ON c.id_client = cmd.id_client
GROUP BY c.nom;

-- Produits les plus vendus
SELECT p.nom, SUM(lc.quantite) AS total_vendu
FROM Produit p
JOIN LigneCommande lc ON p.id_produit = lc.id_produit
GROUP BY p.nom
ORDER BY total_vendu DESC;

-- Produits en rupture de stock (stock < 5)
SELECT nom, stock FROM Produit WHERE stock < 5;