-- Vue : chambres disponibles (non réservées sur une période)
-- Coût total par réservation
SELECT c.nom AS client, h.nom AS hotel, ch.type,
       (julianday(r.date_depart) - julianday(r.date_arrivee)) * ch.prix_nuit AS total
FROM Reservation r
JOIN Client c ON r.id_client = c.id_client
JOIN Chambre ch ON r.id_chambre = ch.id_chambre
JOIN Hotel h ON ch.id_hotel = h.id_hotel;
 
-- Revenus par hôtel
SELECT h.nom, SUM((julianday(r.date_depart) - julianday(r.date_arrivee)) * ch.prix_nuit) AS revenu
FROM Hotel h
JOIN Chambre ch ON h.id_hotel = ch.id_hotel
JOIN Reservation r ON ch.id_chambre = r.id_chambre
GROUP BY h.nom;
 


