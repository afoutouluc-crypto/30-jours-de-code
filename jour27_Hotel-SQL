-- Jour 27 - SQL : Système de réservation hôtelière
-- Niveau L2 - SQL (vues, requêtes avancées)
 
CREATE TABLE Hotel (
    id_hotel INTEGER PRIMARY KEY,
    nom VARCHAR(100),
    ville VARCHAR(50),
    etoiles INTEGER
);
 
CREATE TABLE Chambre (
    id_chambre INTEGER PRIMARY KEY,
    id_hotel INTEGER,
    numero INTEGER,
    type VARCHAR(20), -- simple, double, suite
    prix_nuit DECIMAL(8,2),
    FOREIGN KEY (id_hotel) REFERENCES Hotel(id_hotel)
);
 
CREATE TABLE Client (
    id_client INTEGER PRIMARY KEY,
    nom VARCHAR(50),
    email VARCHAR(100)
);
 
CREATE TABLE Reservation (
    id_reservation INTEGER PRIMARY KEY,
    id_client INTEGER,
    id_chambre INTEGER,
    date_arrivee DATE,
    date_depart DATE,
    FOREIGN KEY (id_client) REFERENCES Client(id_client),
    FOREIGN KEY (id_chambre) REFERENCES Chambre(id_chambre)
);
 
